<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 선택된 탭 배경색 (메인 딥블루/네이비) -->
    <solid android:color="#283593" />

    <!-- 둥근 모서리 반지름 -->
    <corners android:radius="12dp" />

    <!-- 패딩 여백 설정 -->
    <padding
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="4dp" />
</shape>