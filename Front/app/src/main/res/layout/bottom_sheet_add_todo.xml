<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 손잡이 바 디자인 -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="#D1D1D6"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvBottomSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 할 일 간편 추가"
            android:textColor="#283593"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <!-- 1. 할 일 이름 입력 -->
        <EditText
            android:id="@+id/etTodoName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="무슨 일을 해야 하나요?"
            android:background="@android:drawable/editbox_background_normal"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <!-- 2. 예상 소요 시간 입력 (단위: 시간) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="예상 소요 시간"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etExpectedTime"
                android:layout_width="80dp"
                android:layout_height="45dp"
                android:hint="2"
                android:inputType="number"
                android:gravity="center"
                android:background="@android:drawable/editbox_background_normal"
                android:textSize="14sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시간"
                android:textColor="#424242"
                android:layout_marginStart="8dp"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- 3. 우선순위 선택 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="우선순위"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnPriorityHigh"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="상"
                android:textSize="12sp"
                android:backgroundTint="#D1D1D6"
                android:textColor="#333333"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnPriorityMedium"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="중"
                android:textSize="12sp"
                android:backgroundTint="#283593"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnPriorityLow"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="하"
                android:textSize="12sp"
                android:backgroundTint="#D1D1D6"
                android:textColor="#333333"/>
        </LinearLayout>

        <!-- 4. AI 작업 분해 선택 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이 작업을 AI로 나눌까요? 🤖"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnAiNone"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="안 함"
                android:textSize="11sp"
                android:padding="0dp"
                android:backgroundTint="#283593"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnAi3Steps"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="3단계"
                android:textSize="11sp"
                android:padding="0dp"
                android:backgroundTint="#D1D1D6"
                android:textColor="#333333"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnAi5Steps"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="5단계"
                android:textSize="11sp"
                android:padding="0dp"
                android:backgroundTint="#D1D1D6"
                android:textColor="#333333"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnAi7Steps"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="7단계"
                android:textSize="11sp"
                android:padding="0dp"
                android:backgroundTint="#D1D1D6"
                android:textColor="#333333"/>
        </LinearLayout>

        <!-- 5. 등록 버튼 영역 (우측 우측 정렬) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnRegisterTodo"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:text="등록"
                android:textStyle="bold"
                android:backgroundTint="#283593"
                android:textColor="#FFFFFF"/>
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>