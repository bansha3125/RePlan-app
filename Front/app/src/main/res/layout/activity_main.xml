<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- 메인 전체 레이아웃 (상단 고정 영역 + 하단 스크롤 영역) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. [상단 고정 영역 1] 타이틀 & 주간 이동 & 버튼들 -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingHorizontal="16dp"
            android:background="#F8F9FA">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RePlan"
                android:textStyle="bold"
                android:textColor="#283593"
                android:textSize="18sp"
                android:layout_gravity="center"/>

            <!-- 주간 이동 버튼 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/btnPrevWeek"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="‹"
                    android:textSize="22sp"
                    android:textColor="#555555"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tvWeekRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8월 10일 - 8월 16일"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:layout_marginHorizontal="12dp"/>

                <TextView
                    android:id="@+id/btnNextWeek"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="#555555"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center"
                android:layout_marginTop="8dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/modeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI 추천 모드 "
                    android:textColor="#424242"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnAddFixed"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ 고정"
                    android:textSize="11sp"
                    android:backgroundTint="#283593"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:layout_marginStart="8dp"/>

                <Button
                    android:id="@+id/btnAutoSort"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="✨ 자동정렬"
                    android:textSize="11sp"
                    android:backgroundTint="#283593"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ★ [상단 고정 영역 2] 스크롤 시에도 상단 고정되는 7일 날짜 탭 (토요일: 파란색 수정 완료) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:background="#F8F9FA">

            <TextView
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="시간"
                android:textSize="10sp"
                android:textColor="#757575"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:weightSum="7">

                <TextView android:id="@+id/tvTabMon" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="10\n(월)" android:gravity="center" android:textStyle="bold" android:textColor="#333333" android:textSize="11sp" android:background="?attr/selectableItemBackground"/>
                <TextView android:id="@+id/tvTabTue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="11\n(화)" android:gravity="center" android:textStyle="bold" android:textColor="#333333" android:textSize="11sp" android:background="?attr/selectableItemBackground"/>
                <TextView android:id="@+id/tvTabWed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="12\n(수)" android:gravity="center" android:textStyle="bold" android:textColor="#333333" android:textSize="11sp" android:background="?attr/selectableItemBackground"/>
                <TextView android:id="@+id/tvTabThu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="13\n(목)" android:gravity="center" android:textStyle="bold" android:textColor="#333333" android:textSize="11sp" android:background="?attr/selectableItemBackground"/>
                <TextView android:id="@+id/tvTabFri" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="14\n(금)" android:gravity="center" android:textStyle="bold" android:textColor="#333333" android:textSize="11sp" android:background="?attr/selectableItemBackground"/>

                <!-- ★ 토요일: 파란색(#1976D2)으로 개편 -->
                <TextView android:id="@+id/tvTabSat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="15\n(토)" android:gravity="center" android:textStyle="bold" android:textColor="#1976D2" android:textSize="11sp" android:background="?attr/selectableItemBackground"/>

                <!-- 일요일: 빨간색(#D32F2F) 유지 -->
                <TextView android:id="@+id/tvTabSun" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="16\n(일)" android:gravity="center" android:textStyle="bold" android:textColor="#D32F2F" android:textSize="11sp" android:background="?attr/selectableItemBackground"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. [스크롤 영역] 시간표 타임라인 세로 스크롤 -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/plannerScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:paddingBottom="130dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <!-- 좌측 시간 라벨 (00:00 ~ 22:00) -->
                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="2dp">
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="00:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="02:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="04:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="06:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="08:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="10:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="12:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="14:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="16:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="18:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="20:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                    <TextView android:layout_width="match_parent" android:layout_height="52dp" android:text="22:00" android:textSize="9sp" android:textColor="#9E9E9E" android:gravity="top|center_horizontal"/>
                </LinearLayout>

                <!-- 7개 요일 세로 바구니 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:weightSum="7"
                    android:minHeight="624dp">

                    <LinearLayout android:id="@+id/containerMon" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"/>
                    <LinearLayout android:id="@+id/containerTue" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"/>
                    <LinearLayout android:id="@+id/containerWed" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"/>
                    <LinearLayout android:id="@+id/containerThu" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"/>
                    <LinearLayout android:id="@+id/containerFri" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"/>
                    <LinearLayout android:id="@+id/containerSat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"/>
                    <LinearLayout android:id="@+id/containerSun" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- 3. 위아래 가변 바텀시트 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layoutTodoBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="12dp"
        app:behavior_peekHeight="120dp"
        app:behavior_hideable="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="60dp">

            <View
                android:id="@+id/dragHandle"
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_drag_handle"/>

            <LinearLayout
                android:id="@+id/layoutReplayControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:paddingHorizontal="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReplayPrev"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="◀ 이전"
                    android:textSize="12sp"
                    android:textColor="#283593"
                    android:backgroundTint="#F0F2F9"
                    app:cornerRadius="20dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReplayPlay"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.3"
                    android:text="▶ 재생"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#283593"
                    android:layout_marginHorizontal="8dp"
                    app:cornerRadius="20dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReplayNext"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="다음 ▶"
                    android:textSize="12sp"
                    android:textColor="#283593"
                    android:backgroundTint="#F0F2F9"
                    app:cornerRadius="20dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/aiFeedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#E8EAF6"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvAiFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="자동 정렬 버튼을 누르면 AI가 최적의 주간 일정을 배치해 드립니다!"
                    android:textColor="#283593"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/layoutTodoArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✍️ 이번 주에 해결할 할 일"
                    android:textColor="#283593"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTodoList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 4. 최하단 탭바 -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:layout_gravity="bottom">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="홈" android:gravity="center" android:textColor="#283593" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="모아보기" android:gravity="center" android:textColor="#757575" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="주차 플래너" android:gravity="center" android:textColor="#757575" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="설정" android:gravity="center" android:textColor="#757575" android:textSize="12sp"/>
    </LinearLayout>

    <!-- 5. 플로팅 추가 버튼 -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#283593"
        app:tint="#FFFFFF"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="120dp"
        app:elevation="25dp"
        android:contentDescription="일정 추가 버튼"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>