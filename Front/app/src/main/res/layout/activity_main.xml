<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- 1. 주간 시간표 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/plannerScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="130dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 상단 타이틀 영역 -->
            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RePlan"
                    android:textStyle="bold"
                    android:textColor="#283593"
                    android:textSize="18sp"
                    android:layout_gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6월 22일 - 6월 28일"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"/>

                <!-- 모드 스위치 및 버튼 배치 라인 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/modeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI 추천 모드 "
                        android:textColor="#424242"
                        android:textSize="12sp"/>

                    <Button
                        android:id="@+id/btnAddFixed"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="+ 고정"
                        android:textSize="11sp"
                        android:backgroundTint="#283593"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="12dp"
                        android:layout_marginStart="8dp"/>

                    <Button
                        android:id="@+id/btnAutoSort"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="✨ 자동정렬"
                        android:textSize="11sp"
                        android:backgroundTint="#283593"
                        android:textColor="#FFFFFF"
                        android:paddingHorizontal="12dp"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 2. 주간 플래너 영역 (월화수목금토일 세로 바구니) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="12dp">

                <!-- 월화수목금토일 인덱스 라인 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="7"
                    android:paddingBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="월" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="화" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="수" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="목" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="금" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="토" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="일" android:gravity="center" android:textStyle="bold" android:textColor="#333333"/>
                </LinearLayout>

                <!-- 7개의 요일별 세로 바구니 기둥들 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="7"
                    android:minHeight="260dp">

                    <LinearLayout android:id="@+id/containerMon" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minHeight="260dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="4dp"/>
                    <LinearLayout android:id="@+id/containerTue" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minHeight="260dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="4dp"/>
                    <LinearLayout android:id="@+id/containerWed" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minHeight="260dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="4dp"/>
                    <LinearLayout android:id="@+id/containerThu" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minHeight="260dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="4dp"/>
                    <LinearLayout android:id="@+id/containerFri" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minHeight="260dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="4dp"/>
                    <LinearLayout android:id="@+id/containerSat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minHeight="260dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="4dp"/>
                    <LinearLayout android:id="@+id/containerSun" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:minHeight="260dp" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. 위아래로 움직이는 가변 바텀시트 영역 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/layoutTodoBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="24dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="12dp"
        app:behavior_peekHeight="120dp"
        app:behavior_hideable="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="60dp">

            <!-- 드래그 핸들 바 -->
            <View
                android:id="@+id/dragHandle"
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_drag_handle"/>

            <!-- 주간 플래너 하단 리플레이 컨트롤러 바 -->
            <LinearLayout
                android:id="@+id/layoutReplayControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:paddingHorizontal="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReplayPrev"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="◀ 이전"
                    android:textSize="12sp"
                    android:textColor="#283593"
                    android:backgroundTint="#F0F2F9"
                    app:cornerRadius="20dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReplayPlay"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.3"
                    android:text="▶ 재생"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#283593"
                    android:layout_marginHorizontal="8dp"
                    app:cornerRadius="20dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReplayNext"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="다음 ▶"
                    android:textSize="12sp"
                    android:textColor="#283593"
                    android:backgroundTint="#F0F2F9"
                    app:cornerRadius="20dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"/>
            </LinearLayout>

            <!-- AI 피드백 카드 영역 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/aiFeedbackCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#E8EAF6"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tvAiFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:text="호정 님, 자동 정렬 버튼을 누르면 AI가 최적의 주간 일정을 배치해 드립니다!"
                    android:textColor="#283593"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"/>
            </androidx.cardview.widget.CardView>

            <!-- 이번 주 남은 할 일 목록 영역 -->
            <LinearLayout
                android:id="@+id/layoutTodoArea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✍️ 이번 주에 해결할 할 일"
                    android:textColor="#283593"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTodoList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 4. 최하단 고정 탭바 -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:layout_gravity="bottom">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="홈" android:gravity="center" android:textColor="#283593" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="모아보기" android:gravity="center" android:textColor="#757575" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="주차 플래너" android:gravity="center" android:textColor="#757575" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="설정" android:gravity="center" android:textColor="#757575" android:textSize="12sp"/>
    </LinearLayout>

    <!-- 📍 5. 위로 올린 플로팅 버튼 [+] (marginBottom="120dp"로 수정) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#283593"
        app:tint="#FFFFFF"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="120dp"
        app:elevation="25dp"
        android:contentDescription="일정 추가 버튼"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>